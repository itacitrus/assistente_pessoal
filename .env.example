# Google Calendar OAuth App (create at console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth/callback

# ---------------------------------------------------------------------------
# LLM — roteamento por papel
# ---------------------------------------------------------------------------
# Cada papel aceita: deepseek | gemini | anthropic (visao aceita deepseek-vision).
# Ausente = deepseek. O bot SO exige a chave dos providers efetivamente usados.
#
# A separacao OPERACIONAL x CLINICO e por SENSIBILIDADE do usuario, nao por
# tipo de agente: quem PODERIA tocar dado de saude num turno (idoso, quem tem
# medicacao ativa, quem e responsavel por um dependente) vai pro clinico.
LLM_PROVIDER_OPERACIONAL=deepseek
LLM_PROVIDER_CLINICO=deepseek
LLM_PROVIDER_SALES=deepseek
LLM_PROVIDER_ANALYSIS=deepseek
LLM_PROVIDER_REPORT=deepseek
LLM_PROVIDER_VISION=deepseek-vision

# DeepSeek
# ATENCAO: deepseek-chat e deepseek-reasoner foram descontinuados em
# 24/07/2026. Ainda respondem como alias, mas sumiram do /models e da pagina
# de precos. Use deepseek-v4-flash (o v4-pro custa 3,1x mais e pontua PIOR
# em benchmark de agente).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL= (vazio = https://api.deepseek.com; o /v1 e legado)

# Gemini — so necessario se algum papel apontar pra "gemini".
# A garantia de "nao usamos seu conteudo para melhorar nossos produtos" vale
# somente no tier PAGO. No free tier o Google declara o oposto.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Anthropic — so necessario se algum papel apontar pra "anthropic".
# Mantida viva no codigo como rede de seguranca; sem chave, custo zero.
ANTHROPIC_API_KEY=

# AssemblyAI
ASSEMBLYAI_API_KEY=

# Encryption key for storing Google refresh tokens (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=

# Scheduler defaults
DEFAULT_DAILY_SUMMARY_TIME=07:00
DEFAULT_WEEKLY_SUMMARY_DAY=sunday
DEFAULT_WEEKLY_SUMMARY_TIME=20:00
DEFAULT_REMINDER_BEFORE=1h
DEFAULT_AUTO_CONFIRM_TIMEOUT=2h

# Transcription service URL (docker-compose internal)
TRANSCRIPTION_URL=http://transcription:8000
